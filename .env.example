# ─────────────────────────────────────────────────────────────────────────────
# Kaif Board — переменные окружения
#
# Скопируйте файл в .env и заполните значения.
# Секреты сгенерируйте командой:  openssl rand -base64 48
# Файл .env не должен попадать в git и должен иметь права 600.
# ─────────────────────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Домен, на котором работает приложение (без слэша в конце).
DOMAIN=board.example.com
APP_URL=https://board.example.com
API_URL=https://board.example.com
# Почта для Let's Encrypt.
ACME_EMAIL=admin@example.com

# ── База данных ──────────────────────────────────────────────────────────────
POSTGRES_USER=kaif
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=kaif_board
# Внутри docker-compose хост — имя сервиса `postgres`.
DATABASE_URL=postgresql://kaif:ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ@postgres:5432/kaif_board?schema=public&connection_limit=20

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Безопасность ─────────────────────────────────────────────────────────────
# Ключ подписи access-токенов. Минимум 32 символа.
JWT_SECRET=ЗАМЕНИТЕ__openssl_rand_base64_48
ACCESS_TOKEN_TTL_SECONDS=900
# Окно скользящее: продлевается при каждом обращении. Значение важно
# только для того, кто не заходил вообще — у активного человека сессия
# не кончается никогда.
REFRESH_TOKEN_TTL_DAYS=180
# Общий секрет между API и ботом (минимум 24 символа).
INTERNAL_API_SECRET=ЗАМЕНИТЕ__openssl_rand_base64_32
# Домен для cookie. Оставьте пустым, если фронт и API на одном домене.
COOKIE_DOMAIN=
# Приложение работает за обратным прокси (Caddy/nginx).
TRUST_PROXY=true
# Разрешённые Origin через запятую. По умолчанию — только APP_URL.
CORS_ORIGINS=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA_ЗАМЕНИТЕ_НА_ТОКЕН_БОТА
# Имя бота без символа @.
TELEGRAM_BOT_USERNAME=kaif_board_bot
# Секрет вебхука (минимум 16 символов). Используется и в пути вебхука.
TELEGRAM_WEBHOOK_SECRET=ЗАМЕНИТЕ__openssl_rand_hex_16
# Telegram ID тех, кто должен стать суперадмином при первом входе (через запятую).
# Свой ID можно узнать у бота @userinfobot.
SUPERADMIN_TELEGRAM_IDS=

# ── Бот ──────────────────────────────────────────────────────────────────────
# polling — для разработки, webhook — для продакшена.
BOT_MODE=webhook
BOT_WEBHOOK_URL=https://board.example.com
BOT_HOST=0.0.0.0
BOT_PORT=4100
BOT_SET_WEBHOOK=true

# ── Файлы ────────────────────────────────────────────────────────────────────
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=25

# ── Сервер приложения ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
# Запускать фоновые воркеры и реалтайм в процессе API (нормально для одного VPS).
ENABLE_WORKERS=true
ENABLE_REALTIME=true

# ── Ограничение частоты запросов ─────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_WINDOW=10 minutes

# ── Фронтенд (используется на этапе сборки) ──────────────────────────────────
# Пусто = фронт и API на одном домене (рекомендуется).
VITE_API_URL=
